# Consolidation provider — reference sheet for the variables to set.
#
# NOTE: nothing in this workspace loads a `.env` file. There is no dotenv
# dependency; the binaries read the process environment directly. Copying this
# to `.env` would have no effect.
#
# Set these as real environment variables for whatever runs `brain-service.exe`.
# On this machine that is Task Scheduler running as the current user, so they
# belong at User scope:
#
#   setx LLM_API_KEY "<key>"
#
# and then restart AgentBrain.Service, because a process only inherits the
# environment it was started with.
#
# Never put a real key in this file. Real `.env*` files are git-ignored.
# Full reference: docs/operations/llm-configuration.md

# The provider key. Required only when consolidation is configured; everything
# else — capture, retrieval, the startup orientation — runs without it.
LLM_API_KEY=

# The API root. A complete `/responses` endpoint is also accepted exactly once;
# an old `/chat/completions` endpoint is rejected.
# Optional: this value is also the built-in default.
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# The model that answers. Optional: also the built-in default.
LLM_MODEL=gpt-5.6-luna
